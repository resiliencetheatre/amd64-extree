#!/bin/sh
set -eu
[ -f /run/live/session-ready ]
[ "${XDG_RUNTIME_DIR:-}" = /run/user/1000 ]
[ "$(stat -c '%u:%a' "$XDG_RUNTIME_DIR")" = 1000:700 ]
# This is the UTF-8 locale actually generated in the image. C.UTF-8 was not
# generated and xkbcommon could not find its Compose table in Weston sessions.
# The Finnish physical layout remains configured separately in weston.ini.
export LANG=en_US.UTF-8
# Use Unicode borders instead of legacy xterm ACS in Weston terminal.
export NCURSES_NO_UTF8_ACS=1
export GDK_BACKEND=wayland
export XDG_SESSION_TYPE=wayland
renderer=gl
case " $(cat /proc/cmdline) " in *' live.renderer=pixman '*) renderer=pixman; export LIBGL_ALWAYS_SOFTWARE=true;; esac
cd /home/tech
exec dbus-run-session -- weston --backend=drm --renderer="$renderer" --config=/etc/xdg/weston/weston.ini
