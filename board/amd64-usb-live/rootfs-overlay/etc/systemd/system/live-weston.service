[Unit]
Description=Live Weston login session on tty1
After=systemd-user-sessions.service systemd-logind.service
Wants=systemd-logind.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
User=tech
PAMName=live-weston
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user XDG_SEAT=seat0 XDG_VTNR=1 LIBSEAT_BACKEND=logind
ExecStart=/usr/bin/live-session
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
