config BR2_PACKAGE_LIBFIDO2
	bool "libfido2"
	depends on BR2_PACKAGE_HAS_LIBUDEV
	depends on BR2_INSTALL_LIBSTDCPP # libcbor
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_LIBCBOR
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_ZLIB
	help
	  FIDO2 USB authenticator library and command-line tools.
	  This does not enable systemd FIDO2 enrollment support.

	  https://developers.yubico.com/libfido2/
